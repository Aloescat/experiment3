# .env - 修改DATABASE_URL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=student_api_password123
POSTGRES_DB=student_db
DB_PORT=5433

APP_PORT=8000

# 注意：这里有两个DATABASE_URL，一个用于本地开发，一个用于Docker
# 对于Docker容器内部，应该使用 db:5432
# 对于本地开发（不用Docker），使用 localhost:5433

# Docker容器内部使用的连接
DATABASE_URL=postgresql://postgres:student_api_password123@db:5432/student_db

# 本地开发使用的连接（可选）
LOCAL_DATABASE_URL=postgresql://postgres:student_api_password123@localhost:5433/student_db